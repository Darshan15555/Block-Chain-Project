{
    "name": "blockchain-fund-tracker-backend",
    "version": "1.0.0",
    "description": "Backend for Blockchain-Based Transparent Fund Tracking System",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "compile": "node scripts/compile.js",
        "deploy": "node scripts/deploy.js",
        "doctor": "node scripts/doctor.js",
        "seed:reset": "node scripts/seedReset.js",
        "demo:prep": "npm run seed:reset && npm run doctor",
        "test": "jest --runInBand",
        "test:integration": "cross-env RUN_GANACHE_INTEGRATION=true jest --runInBand tests/integration.flow.test.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.5.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "multer": "^2.4.0",
        "solc": "^0.8.23",
        "web3": "^4.3.0"
    },
    "devDependencies": {
        "cross-env": "^7.0.3",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "supertest": "^7.1.1"
    }
}
